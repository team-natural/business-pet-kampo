---
// SCR-24. The cart survives so the buyer can retry — a failed payment should not cost them the
// basket they just assembled.
import Layout from "../../layouts/Layout.astro";
import { requireMemberSession } from "../../lib/server/auth/page";

const session = await requireMemberSession(Astro);
if (session instanceof Response) return session;
---

<Layout title="お支払いを完了できませんでした">
  <main>
    <h1>お支払いを完了できませんでした</h1>
    <p>カードの情報をご確認のうえ、もう一度お試しください。銀行振込への変更も可能です。</p>
    <a href="/checkout">ご発注手続きへ戻る</a>
    <a href="/cart">カートを見る</a>
  </main>
</Layout>
