---
// SCR-09. Where an approved applicant sets their first password (PRD-03 F-01-05). Authenticating
// with OAuth is not approval — that happened in the application review.
import Layout from "../../layouts/Layout.astro";

const { token } = Astro.params;
---

<Layout title="アカウントの有効化">
  <main>
    <h1>アカウントの有効化</h1>
    <p>パスワードを設定すると、卸価格の確認とご発注をご利用いただけます。</p>

    {/* TODO(Phase C): wire to POST /api/v1/auth/activate. */}
    <form method="post" action="/api/v1/auth/activate">
      <input type="hidden" name="token" value={token} />
      <label>パスワード<input type="password" name="password" required minlength="12" autocomplete="new-password" /></label>
      <button type="submit">設定してはじめる</button>
    </form>
  </main>
</Layout>
