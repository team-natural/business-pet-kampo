---
// SCR-20, asking to close the account. Destructive, so it sits on its own page (DEV-06 §4-4).
import Layout from "../../layouts/Layout.astro";
import { requireMemberSession } from "../../lib/server/auth/page";

const session = await requireMemberSession(Astro);
if (session instanceof Response) return session;
---

<Layout title="退会・取引終了のお申し出 — マイページ">
  <main>
    <h1>退会・取引終了のお申し出</h1>
    <p>お申し出の後、運営で内容を確認のうえ手続きを行います。進行中のご発注がある場合は完了後の手続きとなります。</p>

    {/* TODO(Phase C): wire to POST /api/v1/me/withdrawal behind a confirmation dialog. */}
    <form method="post" action="/api/v1/me/withdrawal">
      <label>お申し出の理由<textarea name="reason"></textarea></label>
      <button type="submit">退会を申し出る</button>
    </form>

    <a href="/mypage">マイページへ戻る</a>
  </main>
</Layout>
