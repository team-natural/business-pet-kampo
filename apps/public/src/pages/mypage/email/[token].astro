---
// The landing page for the address-change confirmation link (F-01-06). Deliberately not behind
// requireMemberSession: the member may open it in whichever browser reads the new address's mail,
// and the token — not the session — is what authorises the change.
import Layout from "../../../layouts/Layout.astro";
import ConfirmEmailChange from "../../../lib/components/confirm-email-change.svelte";

const { token } = Astro.params;
---

<Layout title="メールアドレス変更の確認">
  <section class="mx-auto w-full max-w-2xl px-5 py-24 sm:px-8">
    <p class="eyebrow">マイページ</p>
    <h1 class="mt-3 font-display text-3xl text-balance">メールアドレス変更の確認</h1>

    <ConfirmEmailChange client:load token={token!} />
  </section>
</Layout>
