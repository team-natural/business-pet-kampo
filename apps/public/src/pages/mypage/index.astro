---
// SCR-12. The hub every other member page returns to, and where the trading status is explained —
// requireActiveOrganizationForPage sends people here when their organization cannot act.
import { env } from "cloudflare:workers";
import { createDb } from "@app/schema/client";
import Layout from "../../layouts/Layout.astro";
import { listNews } from "../../lib/catalog";
import LogoutButton from "../../lib/components/logout-button.svelte";
import { requireMemberSession } from "../../lib/server/auth/page";
import { viewerFor } from "../../lib/server/auth/session";
import { getMemberByPublicId, toPublicMember } from "../../lib/server/services/members";
import { listOrders } from "../../lib/server/services/orders";
import { ORDER_STATUSES, PAYMENT_STATUSES, formatJapaneseDate, formatYen, statusMeta } from "../../lib/commerce";

const session = await requireMemberSession(Astro);
if (session instanceof Response) return session;

// getSession already joined members, so a miss here means the row vanished mid-request.
const row = await getMemberByPublicId(createDb(env.DB), session.memberPublicId);
if (!row) return Astro.redirect("/login", 302);
const member = toPublicMember(row);

const organization = session.organization;
const canAct = organization?.status === "active" && organization.membershipStatus === "active";

// The summary uses the same viewer rule as /news, so a client_only entry never appears for a
// suspended organization (D-021).
const news = (await listNews(viewerFor(session))).slice(0, 3);

// The order summary (F-05-01). Only for an organization that can act — a suspended partner's
// nav does not offer orders either.
const recentOrders = canAct && organization ? (await listOrders(createDb(env.DB), organization.id)).slice(0, 3) : [];

const STATUS_NOTICE: Record<string, string> = {
  suspended: "現在お取引を一時停止しております。ご不明な点は担当までお問い合わせください。",
  terminated: "お取引は終了しております。再開をご希望の場合は、あらためてお申し込みください。",
};
const notice = organization ? STATUS_NOTICE[organization.status] : "所属する取引先が見つかりません。お手数ですが、お問い合わせください。";
---

<Layout title="マイページ">
  <section class="mx-auto w-full max-w-3xl px-5 py-16 sm:px-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="eyebrow">マイページ</p>
        <h1 class="mt-3 font-display text-3xl text-balance">{member.name} 様</h1>
        <p class="mt-2 text-sm text-ink-soft">{member.email}</p>
        {
          organization && (
            <p class="mt-3 text-sm text-ink-soft">
              {organization.name}（取引先コード <span class="font-mono tabular-nums">{organization.orgCode}</span>）
            </p>
          )
        }
      </div>
      <LogoutButton client:load />
    </div>

    {notice && <p class="mt-8 border border-vermilion px-4 py-3 text-sm leading-relaxed text-pretty text-vermilion">{notice}</p>}

    <nav class="mt-12 grid gap-4 sm:grid-cols-2" aria-label="マイページのメニュー">
      <a href="/mypage/profile" class="border border-rule p-5 hover:border-vermilion">
        <span class="font-display">アカウント情報</span>
        <span class="mt-1 block text-sm text-ink-soft">お名前・メールアドレス・電話番号</span>
      </a>
      <a href="/mypage/company" class="border border-rule p-5 hover:border-vermilion">
        <span class="font-display">会社・取引先情報</span>
        <span class="mt-1 block text-sm text-ink-soft">会社名・請求先の確認と変更申請</span>
      </a>
      {
        canAct && (
          <a href="/mypage/addresses" class="border border-rule p-5 hover:border-vermilion">
            <span class="font-display">配送先</span>
            <span class="mt-1 block text-sm text-ink-soft">お届け先の追加・編集</span>
          </a>
        )
      }
      <a href="/mypage/orders" class="border border-rule p-5 hover:border-vermilion">
        <span class="font-display">発注履歴</span>
        <span class="mt-1 block text-sm text-ink-soft">これまでのご注文の確認</span>
      </a>
    </nav>

    {
      canAct && (
        <div class="mt-16 border-t border-rule pt-8">
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="font-display text-lg">最近のご発注</h2>
            <a href="/mypage/orders" class="text-sm underline underline-offset-4 hover:text-vermilion">
              すべて見る
            </a>
          </div>

          {recentOrders.length === 0 ? (
            <p class="mt-4 text-sm text-ink-soft">ご発注の履歴はまだありません。</p>
          ) : (
            <ul class="mt-4 border-t border-rule">
              {recentOrders.map((order) => (
                <li class="border-b border-rule">
                  <a href={`/mypage/orders/${order.id}`} class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4 text-sm transition-colors hover:text-vermilion">
                    <span class="font-mono tabular-nums">{order.orderNumber}</span>
                    <span class="flex flex-wrap items-center gap-3">
                      <time datetime={order.placedAt} class="font-mono text-xs text-ink-soft tabular-nums">
                        {formatJapaneseDate(order.placedAt)}
                      </time>
                      <span class="border border-rule px-2 py-0.5 text-xs">{statusMeta(ORDER_STATUSES, order.status).label}</span>
                      <span class="border border-rule px-2 py-0.5 text-xs">{statusMeta(PAYMENT_STATUSES, order.paymentStatus).label}</span>
                      <span class="font-mono tabular-nums">{formatYen(order.total)}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }

    <div class="mt-16 border-t border-rule pt-8">
      <h2 class="font-display text-lg">お知らせ</h2>
      {
        news.length === 0 ? (
          <p class="mt-4 text-sm text-ink-soft">お知らせはまだありません。</p>
        ) : (
          <ul class="mt-4 flex flex-col gap-3">
            {news.map((entry) => (
              <li class="flex flex-wrap items-baseline gap-3 text-sm">
                <time datetime={entry.data.publishedDate.toISOString()} class="font-mono text-ink-soft tabular-nums">
                  {entry.data.publishedDate.toLocaleDateString("ja-JP")}
                </time>
                <a href={`/news/${entry.id}`} class="underline underline-offset-4 hover:text-vermilion">
                  {entry.data.title}
                </a>
                {entry.data.visibility === "client_only" && <span class="border border-rule px-2 py-0.5 text-xs text-ink-soft">取引先限定</span>}
              </li>
            ))}
          </ul>
        )
      }
      <a href="/news" class="btn btn-quiet mt-6">お知らせ一覧へ</a>
    </div>
  </section>
</Layout>
