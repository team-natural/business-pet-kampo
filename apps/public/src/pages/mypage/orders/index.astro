---
// SCR-18. Only this organization's orders (DEV-02 §3-1) — the scope is in listOrders' WHERE
// clause, not in a comparison after the rows come back.
import { env } from "cloudflare:workers";
import { createDb } from "@app/schema/client";
import Layout from "../../../layouts/Layout.astro";
import { ORDER_STATUSES, PAYMENT_STATUSES, formatJapaneseDate, formatYen, statusMeta } from "../../../lib/commerce";
import { requireActiveOrganizationForPage, requireMemberSession } from "../../../lib/server/auth/page";
import { listOrders } from "../../../lib/server/services/orders";

const session = await requireMemberSession(Astro);
if (session instanceof Response) return session;

const organization = requireActiveOrganizationForPage(Astro, session);
if (organization instanceof Response) return organization;

// Every buyer at the company sees the company's orders, not just their own — the tenant boundary
// is the organization, and a colleague's order is the same company's business (DEV-07 §1).
const orders = await listOrders(createDb(env.DB), organization.id);
---

<Layout title="発注履歴 — マイページ">
  <section class="mx-auto w-full max-w-4xl px-5 py-16 sm:px-8">
    <p class="eyebrow">マイページ</p>
    <h1 class="mt-3 font-display text-3xl text-balance">発注履歴</h1>
    <p class="mt-4 max-w-prose text-sm leading-relaxed text-pretty text-ink-soft">{organization.name} のご発注をすべて表示しています。</p>

    {
      orders.length === 0 ? (
        <div class="mt-10 border border-rule px-6 py-12 text-center">
          <p class="font-display text-lg">ご発注の履歴はまだありません</p>
          <a href="/products" class="btn btn-quiet mt-8">
            商品を見る
          </a>
        </div>
      ) : (
        /* A list of cards rather than a table: five columns do not survive a phone, and orders are
          read from the shop floor (BIZ-01 §3-2). */
        <ul class="mt-10 flex flex-col gap-4">
          {orders.map((order) => (
            <li class="border border-rule p-5" data-testid="order-row">
              <a href={`/mypage/orders/${order.id}`} class="block transition-colors hover:text-vermilion">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <span class="font-mono tabular-nums">{order.orderNumber}</span>
                  <span class="font-mono text-lg tabular-nums">{formatYen(order.total)}</span>
                </div>
                <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                  <time datetime={order.placedAt} class="font-mono text-xs text-ink-soft tabular-nums">
                    {formatJapaneseDate(order.placedAt)}
                  </time>
                  {/* Colour never carries the meaning on its own — the label ships with it (DEV-06 §9). */}
                  <span class="border border-rule px-2 py-0.5 text-xs">{statusMeta(ORDER_STATUSES, order.status).label}</span>
                  <span class="border border-rule px-2 py-0.5 text-xs">{statusMeta(PAYMENT_STATUSES, order.paymentStatus).label}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-16 text-sm">
      <a href="/mypage" class="underline underline-offset-4 hover:text-vermilion">マイページへ戻る</a>
    </p>
  </section>
</Layout>
