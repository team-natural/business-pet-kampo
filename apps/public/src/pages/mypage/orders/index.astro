---
// SCR-18 発注履歴。自 Organization 分のみ（DEV-02 §3-1）。
import Layout from "../../../layouts/Layout.astro";
import { ORDER_STATUSES, PAYMENT_STATUSES, formatYen, statusMeta } from "../../../lib/commerce";
import { requireMemberSession } from "../../../lib/server/auth/page";

const session = await requireMemberSession(Astro);
if (session instanceof Response) return session;

// TODO(Phase C): listOrdersForOrganization(db, organization.id) を呼ぶ。
const orders: { publicId: string; orderNumber: string; placedAt: string; status: string; paymentStatus: string; total: number }[] = [];
---

<Layout title="発注履歴 — マイページ">
  <main>
    <h1>発注履歴</h1>

    <table>
      <thead>
        <tr><th>注文番号</th><th>発注日</th><th>ステータス</th><th>お支払い</th><th>合計</th></tr>
      </thead>
      <tbody>
        {
          orders.map((order) => (
            <tr>
              <td>
                <a href={`/mypage/orders/${order.publicId}`}>{order.orderNumber}</a>
              </td>
              <td>{order.placedAt}</td>
              <td>{statusMeta(ORDER_STATUSES, order.status).label}</td>
              <td>{statusMeta(PAYMENT_STATUSES, order.paymentStatus).label}</td>
              <td>{formatYen(order.total)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    {orders.length === 0 && <p>ご発注の履歴はまだありません。</p>}
  </main>
</Layout>
