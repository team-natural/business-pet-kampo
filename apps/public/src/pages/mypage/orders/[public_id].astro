---
// SCR-19. Amounts and product names come from order_items' snapshot columns — re-reading the
// Markdown would rewrite past order totals at every price revision (DEV-07 §6-0).
import Layout from "../../../layouts/Layout.astro";
import { requireMemberSession } from "../../../lib/server/auth/page";

const session = await requireMemberSession(Astro);
if (session instanceof Response) return session;

const publicId = Astro.params.public_id!;
// TODO(Phase C): read only this organization's orders, and answer 404 when there is no match.
---

<Layout title="発注詳細 — マイページ">
  <main>
    <h1>発注詳細</h1>
    <p>{publicId}</p>

    <a href="/mypage/orders">発注履歴へ戻る</a>
  </main>
</Layout>
