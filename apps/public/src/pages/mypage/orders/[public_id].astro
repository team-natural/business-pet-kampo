---
// SCR-19 発注詳細。金額・商品名は order_items のスナップショット列から表示する — Markdown を
// 読み直すと価格改定のたびに過去の注文金額が書き換わる（DEV-07 §6-0）。
import Layout from "../../../layouts/Layout.astro";
import { loginRedirect, memberSession } from "../../../lib/server/auth/page";

const session = await memberSession(Astro);
if (!session) return loginRedirect(Astro);

const publicId = Astro.params.public_id!;
// TODO(Phase C): 自 Organization の注文だけを引き、見つからなければ 404 相当に落とす。
---

<Layout title="発注詳細 — マイページ">
  <main>
    <h1>発注詳細</h1>
    <p>{publicId}</p>

    <a href="/mypage/orders">発注履歴へ戻る</a>
  </main>
</Layout>
