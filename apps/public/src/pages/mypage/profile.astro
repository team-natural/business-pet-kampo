---
// SCR-13, the member's own account details.
import Layout from "../../layouts/Layout.astro";
import { requireMemberSession } from "../../lib/server/auth/page";

const session = await requireMemberSession(Astro);
if (session instanceof Response) return session;
---

<Layout title="アカウント情報 — マイページ">
  <main>
    <h1>アカウント情報</h1>

    {/* TODO(Phase C): show the current values from GET /api/v1/me and wire the form to PATCH /api/v1/me. */}
    <form method="post" action="/api/v1/me">
      <label>お名前<input type="text" name="name" required /></label>
      <label>メールアドレス<input type="email" name="email" required /></label>
      <label>電話番号<input type="tel" name="phone" /></label>
      <button type="submit">保存する</button>
    </form>

    <a href="/mypage">マイページへ戻る</a>
  </main>
</Layout>
