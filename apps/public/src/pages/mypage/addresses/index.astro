---
// SCR-15. Only this organization's addresses (DEV-02 §3-1).
import Layout from "../../../layouts/Layout.astro";
import { requireMemberSession } from "../../../lib/server/auth/page";

const session = await requireMemberSession(Astro);
if (session instanceof Response) return session;

// TODO(Phase C): call listShippingAddresses(db, organization.id). The scope belongs in the WHERE
// clause, not in a comparison after the rows come back — a forgotten comparison still runs.
const addresses: { publicId: string; recipientName: string; address: string; isDefault: boolean }[] = [];
---

<Layout title="配送先 — マイページ">
  <main>
    <h1>配送先</h1>
    <a href="/mypage/addresses/new">配送先を追加する</a>

    <ul>
      {
        addresses.map((address) => (
          <li>
            <span>{address.recipientName}</span>
            <span>{address.address}</span>
            {address.isDefault && <span>既定</span>}
            <a href={`/mypage/addresses/${address.publicId}/edit`}>編集</a>
          </li>
        ))
      }
    </ul>
    {addresses.length === 0 && <p>登録済みの配送先はありません。</p>}
  </main>
</Layout>
