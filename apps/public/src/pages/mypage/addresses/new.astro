---
// SCR-16, adding a shipping address.
import Layout from "../../../layouts/Layout.astro";
import { requireMemberSession } from "../../../lib/server/auth/page";

const session = await requireMemberSession(Astro);
if (session instanceof Response) return session;
---

<Layout title="配送先の追加 — マイページ">
  <main>
    <h1>配送先の追加</h1>

    {/* TODO(Phase C): wire to POST /api/v1/addresses. organization_id comes from the session, never from the body. */}
    <form method="post" action="/api/v1/addresses">
      <label>宛名<input type="text" name="recipientName" required /></label>
      <label>郵便番号<input type="text" name="postalCode" required /></label>
      <label>住所<input type="text" name="address" required /></label>
      <label>電話番号<input type="tel" name="phone" required /></label>
      <label><input type="checkbox" name="isDefault" value="1" />既定の配送先にする</label>
      <button type="submit">登録する</button>
    </form>

    <a href="/mypage/addresses">配送先一覧へ戻る</a>
  </main>
</Layout>
