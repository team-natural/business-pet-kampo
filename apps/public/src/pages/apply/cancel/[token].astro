---
// SCR-36. No login is involved, so the token in the URL is the only evidence of who is asking.
// TODO(Phase C): verify the token server-side and call DELETE /api/v1/applications/{public_id}.
// Expired, already used and forged all answer with the same wording.
import Layout from "../../../layouts/Layout.astro";

const { token } = Astro.params;
---

<Layout title="お申し込みの取消">
  <main>
    <h1>お申し込みの取消</h1>
    <form method="post" action="/api/v1/applications/cancel">
      <input type="hidden" name="token" value={token} />
      <p>お申し込みを取り消します。よろしければ下のボタンを押してください。</p>
      <button type="submit">申し込みを取り消す</button>
    </form>
  </main>
</Layout>
