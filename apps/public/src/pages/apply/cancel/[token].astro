---
// SCR-36 申請の取消。ログインを伴わないので、URL のトークンだけが本人性の根拠になる。
// TODO(Phase C): トークンを検証して DELETE /api/v1/applications/{public_id} を呼ぶ。
// 検証はサーバー側で行い、期限切れ・使用済み・不正のいずれも同じ文言で返す。
import Layout from "../../../layouts/Layout.astro";

const { token } = Astro.params;
---

<Layout title="お申し込みの取消">
  <main>
    <h1>お申し込みの取消</h1>
    <form method="post" action="/api/v1/applications/cancel">
      <input type="hidden" name="token" value={token} />
      <p>お申し込みを取り消します。よろしければ下のボタンを押してください。</p>
      <button type="submit">申し込みを取り消す</button>
    </form>
  </main>
</Layout>
