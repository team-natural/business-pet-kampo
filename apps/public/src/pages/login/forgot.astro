---
// SCR-10. An unknown address gets the same screen in the same time as a known one — a difference
// turns this into a membership oracle.
import Layout from "../../layouts/Layout.astro";
---

<Layout title="パスワードの再設定">
  <main>
    <h1>パスワードの再設定</h1>
    <p>ご登録のメールアドレスを入力してください。再設定用のリンクをお送りします。</p>

    {/* TODO(Phase C): wire to POST /api/v1/auth/password/forgot. */}
    <form method="post" action="/api/v1/auth/password/forgot">
      <label>メールアドレス<input type="email" name="email" required /></label>
      <button type="submit">再設定メールを送る</button>
    </form>

    <a href="/login">ログインへ戻る</a>
  </main>
</Layout>
