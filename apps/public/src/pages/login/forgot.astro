---
// SCR-10. An unknown address gets the same screen in the same time as a known one — a difference
// turns this into a membership oracle (DEV-02 §7).
import Layout from "../../layouts/Layout.astro";
import ForgotForm from "../../lib/components/forgot-form.svelte";
---

<Layout title="パスワードの再設定">
  <section class="mx-auto w-full max-w-2xl px-5 py-24 sm:px-8">
    <p class="eyebrow">ログイン</p>
    <h1 class="mt-3 font-display text-3xl text-balance">パスワードの再設定</h1>
    <p class="mt-5 max-w-prose leading-loose text-pretty text-ink-soft">ご登録のメールアドレスを入力してください。再設定用のリンクをお送りします。</p>

    <ForgotForm client:load />

    <p class="mt-10 text-sm">
      <a href="/login" class="underline underline-offset-4 hover:text-vermilion">ログインへ戻る</a>
    </p>
  </section>
</Layout>
