---
// SCR-11. The token is verified by the POST handler, not here — see the note in
// activate/[token].astro: expired, used and forged have to be indistinguishable.
import Layout from "../../../layouts/Layout.astro";
import PasswordForm from "../../../lib/components/password-form.svelte";

const { token } = Astro.params;
---

<Layout title="新しいパスワードの設定">
  <section class="mx-auto w-full max-w-2xl px-5 py-24 sm:px-8">
    <p class="eyebrow">パスワードの再設定</p>
    <h1 class="mt-3 font-display text-3xl text-balance">新しいパスワードの設定</h1>
    <p class="mt-5 max-w-prose leading-loose text-pretty text-ink-soft">新しいパスワードを設定します。設定すると、ログイン中の端末はすべてログアウトされます。</p>

    {
      /* Lands on /login, not /mypage: a reset does not sign anyone in, so the new password gets
        typed once at the login screen (DEV-09 §2-4-4). */
    }
    <PasswordForm client:load endpoint="/api/v1/auth/password/reset" token={token!} submitLabel="パスワードを設定する" submittingLabel="設定しています…" redirectTo="/login" />
  </section>
</Layout>
