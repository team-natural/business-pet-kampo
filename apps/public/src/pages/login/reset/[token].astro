---
// SCR-11. The token is verified server-side, by the POST handler.
import Layout from "../../../layouts/Layout.astro";

const { token } = Astro.params;
---

<Layout title="新しいパスワードの設定">
  <main>
    <h1>新しいパスワードの設定</h1>

    {/* TODO(Phase C): wire to POST /api/v1/auth/password/reset. Expired and already-used answer with the same wording. */}
    <form method="post" action="/api/v1/auth/password/reset">
      <input type="hidden" name="token" value={token} />
      <label>新しいパスワード<input type="password" name="password" required minlength="12" autocomplete="new-password" /></label>
      <button type="submit">パスワードを設定する</button>
    </form>
  </main>
</Layout>
