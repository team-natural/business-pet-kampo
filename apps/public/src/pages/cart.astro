---
// SCR-21 カート。卸価格はサーバー側で解決して描画する — island の props に渡すとクライアントの
// HTML に現れる（D-021、DEV-06 §7）。
import Layout from "../layouts/Layout.astro";
import { MINIMUM_ORDER_SUBTOTAL, formatYen, orderTotals } from "../lib/commerce";
import { requireMemberSession } from "../lib/server/auth/page";

const session = await requireMemberSession(Astro);
if (session instanceof Response) return session;

// TODO(Phase C): getCart(db, organization.id, member.id) で明細を解決する。単価は
// resolveWholesalePrice（取引先別価格 → 標準卸価格）で都度解決する（DEV-07 §6-0）。
const items: { id: number; name: string; unitPrice: number; quantity: number; subtotal: number }[] = [];
const subtotal = items.reduce((sum, item) => sum + item.subtotal, 0);
const totals = orderTotals(subtotal);
const meetsMinimum = subtotal >= MINIMUM_ORDER_SUBTOTAL;
---

<Layout title="カート">
  <main>
    <h1>カート</h1>

    <ul>
      {
        items.map((item) => (
          <li>
            <span>{item.name}</span>
            <span>
              {formatYen(item.unitPrice)} × {item.quantity}
            </span>
            <span>{formatYen(item.subtotal)}</span>
          </li>
        ))
      }
    </ul>

    {
      items.length === 0 ? (
        <p>
          カートは空です。<a href="/products">商品一覧へ</a>
        </p>
      ) : (
        <section>
          <dl>
            <>
              <dt>小計（税抜）</dt>
              <dd>{formatYen(totals.subtotal)}</dd>
            </>
            <>
              <dt>送料</dt>
              <dd>{formatYen(totals.shippingFee)}</dd>
            </>
            <>
              <dt>消費税</dt>
              <dd>{formatYen(totals.tax)}</dd>
            </>
            <>
              <dt>合計</dt>
              <dd>{formatYen(totals.total)}</dd>
            </>
          </dl>
          {/* 画面側の表示であって判定ではない。確定判定は POST /api/v1/checkout で行う（DEV-06 §7）。 */}
          {!meetsMinimum && <p>最低発注金額は税抜 {formatYen(MINIMUM_ORDER_SUBTOTAL)} です。</p>}
          <a href="/checkout">ご発注手続きへ</a>
        </section>
      )
    }
  </main>
</Layout>
