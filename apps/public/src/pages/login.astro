---
// SCR-09. Not `/` like apps/admin: there the whole site is behind auth, here `/` is the public
// top page.
import { env } from "cloudflare:workers";
import { createDb } from "@app/schema/client";
import Layout from "../layouts/Layout.astro";
import LoginForm from "../lib/components/login-form.svelte";
import { PROVIDER_LABELS, configuredProviders, isOAuthProvider, type OAuthEnv } from "../lib/server/auth/oauth";
import { getSession } from "../lib/server/auth/session";

const session = await getSession(Astro.cookies, createDb(env.DB));
if (session) return Astro.redirect("/mypage", 302);

// Workers Secrets, so they are absent from the generated Cloudflare.Env (DEV-10 §1-3).
const providers = configuredProviders(env as typeof env & OAuthEnv);

// Set by the callback when it found this address but no link for the provider yet.
const linkParam = Astro.url.searchParams.get("link");
const linking = isOAuthProvider(linkParam) ? PROVIDER_LABELS[linkParam] : null;
const oauthFailed = Astro.url.searchParams.get("error") === "oauth";
---

<Layout title="ログイン">
  <section class="mx-auto w-full max-w-md px-5 py-16 sm:px-8">
    <p class="eyebrow">取引先の皆さま</p>
    <h1 class="mt-3 font-display text-3xl text-balance">ログイン</h1>

    {
      linking && (
        <p role="status" class="mt-8 border border-rule px-4 py-3 text-sm leading-relaxed text-pretty">
          {/* Said before the password field, not after: the member needs to know why they are being
              asked for it when they clicked a social button. */}
          {linking} のアカウントを確認しました。続けてパスワードでログインしていただくと、次回から {linking} でログインできるようになります。
        </p>
      )
    }

    {
      oauthFailed && (
        <p role="alert" class="mt-8 border border-vermilion px-4 py-3 text-sm leading-relaxed text-pretty text-vermilion">
          ログインを完了できませんでした。お手数ですが、もう一度お試しください。
        </p>
      )
    }

    <LoginForm client:load />

    {
      providers.length > 0 && (
        <div class="mt-10 border-t border-rule pt-8">
          <h2 class="text-sm text-ink-soft">他の方法でログイン</h2>
          <ul class="mt-4 flex flex-col gap-3">
            {providers.map((provider) => (
              <li>
                {/* A plain link, not a form or an island: the route only ever answers with a redirect. */}
                <a href={`/auth/${provider}`} class="btn btn-quiet w-full" rel="nofollow">
                  {PROVIDER_LABELS[provider]} でログイン
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-xs leading-relaxed text-pretty text-ink-soft">お取引の承認を受けたアカウントのみご利用いただけます。</p>
        </div>
      )
    }

    <div class="mt-10 flex flex-col gap-2 text-sm">
      <a href="/login/forgot" class="underline underline-offset-4 hover:text-vermilion">パスワードをお忘れの方</a>
      <a href="/apply" class="underline underline-offset-4 hover:text-vermilion">新規にお取引をご希望の方</a>
    </div>
  </section>
</Layout>
