---
// ADM-14, the trading partner listing.
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import FilterBar from "$lib/components/filter-bar.astro";
import PageHeader from "$lib/components/page-header.astro";
import Pagination from "$lib/components/pagination.astro";
import RowLink from "$lib/components/row-link.svelte";
import StatusBadge from "$lib/components/status-badge.svelte";
import * as Table from "$lib/components/ui/table/index.js";
import { requireAdminUser } from "$lib/server/auth/access";
import { type OrganizationStatus, listOrganizations } from "$lib/server/services/organizations";
import { STATUS_MAPS } from "$lib/status";

const admin = await requireAdminUser(Astro);

const STATUSES: OrganizationStatus[] = ["active", "suspended", "terminated"];
const params = Astro.url.searchParams;
const status = params.get("status");

const { items, page, perPage, total } = await listOrganizations(Astro.locals.db, {
  status: STATUSES.includes(status as OrganizationStatus) ? (status as OrganizationStatus) : undefined,
  keyword: params.get("q") ?? undefined,
  page: Number(params.get("page") ?? 1),
});

const statusOptions = STATUSES.map((value) => ({ value, label: STATUS_MAPS.organization[value]!.label }));
---

<ConsoleLayout title="取引先" user={admin} breadcrumbs={[{ label: "取引先" }]}>
  <PageHeader title="取引先" description="承認済みの取引先を横断して確認し、取引の停止・再開を行います。" />

  <FilterBar keyword={{ name: "q", label: "会社名", value: params.get("q") ?? "", placeholder: "会社名で絞り込む" }} selects={[{ name: "status", label: "ステータス", value: status ?? "", allLabel: "すべて", options: statusOptions }]} />

  <DataTable caption="取引先の一覧" columns={["取引先コード", "会社名", "ステータス", "発注可否"]} rowCount={items.length} emptyTitle="該当する取引先はありません" emptyDescription="新規取引申請を承認すると、その会社がここに並びます。" emptyActionHref="/applications" emptyActionLabel="新規取引申請を見る">
    {
      items.map((organization) => (
        <Table.Row>
          <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{organization.orgCode}</Table.Cell>
          <Table.Cell>
            <RowLink href={`/organizations/${organization.id}`}>{organization.name}</RowLink>
          </Table.Cell>
          <Table.Cell>
            <StatusBadge domain="organization" value={organization.status} />
          </Table.Cell>
          <Table.Cell class="text-muted-foreground">{organization.orderEnabled ? "可" : "不可"}</Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>

  <Pagination page={page} perPage={perPage} total={total} params={params} />
</ConsoleLayout>
