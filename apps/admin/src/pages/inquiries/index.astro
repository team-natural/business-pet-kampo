---
// ADM-22. Keyset paginated, so there is no total and no last page to show (DEV-06 §4-2).
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import { decodeCursor, encodeCursor } from "@app/server-kit/http";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import RowLink from "$lib/components/row-link.svelte";
import StatusBadge from "$lib/components/status-badge.svelte";
import { Button } from "$lib/components/ui/button/index.js";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDateTime } from "$lib/format";
import { requireAdminUser } from "$lib/server/auth/access";
import { listInquiries } from "$lib/server/services/inquiries";
import { label } from "$lib/status";

const admin = await requireAdminUser(Astro);

const { items, nextId } = await listInquiries(Astro.locals.db, { beforeId: decodeCursor(Astro.url.searchParams.get("cursor")) });
---

<ConsoleLayout title="お問い合わせ" user={admin} breadcrumbs={[{ label: "お問い合わせ" }]}>
  <PageHeader title="お問い合わせ" description="公開サイトのフォームから届いた問い合わせです。新しい順に並びます。" />

  <DataTable caption="お問い合わせの一覧" columns={["受信日時", "会社名", "お名前", "種別", "ステータス"]} rowCount={items.length} emptyTitle="お問い合わせはありません" emptyDescription="公開サイトのフォームから届くとここに表示されます。">
    {
      items.map((inquiry) => (
        <Table.Row>
          <Table.Cell class="whitespace-nowrap tabular-nums">
            <RowLink href={`/inquiries/${inquiry.id}`}>{formatDateTime(inquiry.createdAt)}</RowLink>
          </Table.Cell>
          <Table.Cell class="text-muted-foreground">{inquiry.companyName ?? "—"}</Table.Cell>
          <Table.Cell>{inquiry.name}</Table.Cell>
          <Table.Cell class="text-muted-foreground">{label("inquiryType", inquiry.inquiryType)}</Table.Cell>
          <Table.Cell>
            <StatusBadge domain="inquiry" value={inquiry.status} />
          </Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>

  {
    nextId && (
      <nav aria-label="ページ送り" class="flex justify-end">
        <Button href={`/inquiries?cursor=${encodeCursor(nextId)}`} variant="outline" size="sm">
          次のページ
        </Button>
      </nav>
    )
  }
</ConsoleLayout>
