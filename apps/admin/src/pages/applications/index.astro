---
// ADM-12. Filters live in the URL query so a filtered view survives a reload and can be shared.
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import FilterBar from "$lib/components/filter-bar.astro";
import PageHeader from "$lib/components/page-header.astro";
import Pagination from "$lib/components/pagination.astro";
import RowLink from "$lib/components/row-link.svelte";
import StatusBadge from "$lib/components/status-badge.svelte";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDate } from "$lib/format";
import { requireAdminUser } from "$lib/server/auth/access";
import { type ApplicationStatus, listApplications } from "$lib/server/services/applications";
import { STATUS_MAPS } from "$lib/status";

const admin = await requireAdminUser(Astro);

const STATUSES: ApplicationStatus[] = ["received", "reviewing", "needs_confirmation", "approved", "rejected", "withdrawn"];
const params = Astro.url.searchParams;
const status = params.get("status");

const { items, page, perPage, total } = await listApplications(Astro.locals.db, {
  status: STATUSES.includes(status as ApplicationStatus) ? (status as ApplicationStatus) : undefined,
  keyword: params.get("q") ?? undefined,
  page: Number(params.get("page") ?? 1),
});

const statusOptions = STATUSES.map((value) => ({ value, label: STATUS_MAPS.application[value]!.label }));
---

<ConsoleLayout title="新規取引申請" user={admin} breadcrumbs={[{ label: "新規取引申請" }]}>
  <PageHeader title="新規取引申請" description="公開サイトから届いた取引申請です。新しい順に並びます。" />

  <FilterBar keyword={{ name: "q", label: "会社名", value: params.get("q") ?? "", placeholder: "会社名で絞り込む" }} selects={[{ name: "status", label: "ステータス", value: status ?? "", allLabel: "すべて", options: statusOptions }]} />

  <DataTable caption="新規取引申請の一覧" columns={["申請日", "会社名", "ご担当者", "ステータス"]} rowCount={items.length} emptyTitle="該当する申請はありません" emptyDescription="絞り込み条件を変えるか、新しい申請が届くのをお待ちください。">
    {
      items.map((application) => (
        <Table.Row>
          <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{formatDate(application.appliedAt)}</Table.Cell>
          <Table.Cell>
            <RowLink href={`/applications/${application.id}`}>{application.companyName}</RowLink>
          </Table.Cell>
          <Table.Cell>{application.contactName}</Table.Cell>
          <Table.Cell>
            <StatusBadge domain="application" value={application.status} />
          </Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>

  <Pagination page={page} perPage={perPage} total={total} params={params} />
</ConsoleLayout>
