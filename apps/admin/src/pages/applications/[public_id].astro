---
// ADM-13. Also the screen where the partner code (org_code) is assigned on approval (D-019).
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DetailCard from "$lib/components/detail-card.astro";
import PageHeader from "$lib/components/page-header.astro";
import ReviewActions from "$lib/components/review-actions.svelte";
import StatusBadge from "$lib/components/status-badge.svelte";
import { formatDateTime } from "$lib/format";
import { requireAdminUser } from "$lib/server/auth/access";
import { allowedTransitions, getApplicationByPublicId } from "$lib/server/services/applications";
import { statusMeta } from "$lib/status";

const admin = await requireAdminUser(Astro);

const application = await getApplicationByPublicId(Astro.locals.db, Astro.params.public_id!);
// Buttons are enabled only for moves the state machine allows; the API refuses the rest with 409
// regardless (DEV-06 §4-3).
const transitions = allowedTransitions(application.status);
---

<ConsoleLayout title={`${application.companyName} — 申請詳細`} user={admin} breadcrumbs={[{ label: "新規取引申請", href: "/applications" }, { label: application.companyName }]}>
  <PageHeader title={application.companyName} description={`申請日時 ${formatDateTime(application.appliedAt)}`}>
    <StatusBadge slot="meta" domain="application" value={application.status} />
  </PageHeader>

  <DetailCard title="申請内容">
    <div><dt>法人番号</dt><dd class="tabular-nums">{application.corporateNumber ?? "—"}</dd></div>
    <div><dt>事業者種別</dt><dd>{application.businessType ?? "—"}</dd></div>
    <div><dt>業種</dt><dd>{application.industry ?? "—"}</dd></div>
    <div><dt>所在地</dt><dd>〒{application.postalCode} {application.address}</dd></div>
    <div><dt>代表者</dt><dd>{application.representativeName}</dd></div>
    <div><dt>ご担当者</dt><dd>{application.contactName}（{application.contactDepartment ?? "—"}）</dd></div>
    <div><dt>連絡先</dt><dd>{application.phone} / {application.email}</dd></div>
    <div><dt>Web / SNS</dt><dd>{application.website ?? "—"} / {application.sns ?? "—"}</dd></div>
    <div><dt>実店舗</dt><dd>{application.hasPhysicalStore ? "あり" : "なし"}</dd></div>
    <div><dt>販売予定チャネル</dt><dd>{application.plannedSalesChannels ?? "—"}</dd></div>
    <div><dt>希望商品</dt><dd>{application.desiredProducts ?? "—"}</dd></div>
    <div><dt>希望支払方法</dt><dd>{application.desiredPaymentMethod ?? "—"}</dd></div>
    <div><dt>ご相談内容</dt><dd class="whitespace-pre-wrap">{application.notes ?? "—"}</dd></div>
    <div><dt>同意した規約版</dt><dd>{application.agreedTermsVersion}</dd></div>
  </DetailCard>

  <DetailCard title="審査" list={false}>
    <dl class="detail-list mb-6 text-sm">
      <div><dt>審査日時</dt><dd class="tabular-nums">{formatDateTime(application.reviewedAt)}</dd></div>
      <div>
        <dt>遷移可能</dt>
        <dd>{transitions.length > 0 ? transitions.map((to) => statusMeta("application", to).label).join(" / ") : "なし（終端）"}</dd>
      </div>
    </dl>

    {
      /* client:load — the panel is why the reviewer opened this screen, and every control in it
        stays inert until hydration. */
    }
    <ReviewActions client:load publicId={application.id} transitions={transitions} reviewMemo={application.reviewMemo} suggestedMemberName={application.contactName} suggestedMemberEmail={application.email} />
  </DetailCard>
</ConsoleLayout>
