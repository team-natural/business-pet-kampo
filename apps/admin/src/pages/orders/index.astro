---
// ADM-17, the order listing.
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import FilterBar from "$lib/components/filter-bar.astro";
import PageHeader from "$lib/components/page-header.astro";
import Pagination from "$lib/components/pagination.astro";
import RowLink from "$lib/components/row-link.svelte";
import StatusBadge from "$lib/components/status-badge.svelte";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDate, formatYen } from "$lib/format";
import { requireAdminUser } from "$lib/server/auth/access";
import { type OrderStatus, listOrders } from "$lib/server/services/orders";
import { STATUS_MAPS } from "$lib/status";

const admin = await requireAdminUser(Astro);

const STATUSES: OrderStatus[] = ["received", "confirming", "preparing", "shipped", "completed", "cancelled"];
const params = Astro.url.searchParams;
const status = params.get("status");

const { items, page, perPage, total } = await listOrders(Astro.locals.db, {
  status: STATUSES.includes(status as OrderStatus) ? (status as OrderStatus) : undefined,
  page: Number(params.get("page") ?? 1),
});

const statusOptions = STATUSES.map((value) => ({ value, label: STATUS_MAPS.order[value]!.label }));
---

<ConsoleLayout title="受注" user={admin} breadcrumbs={[{ label: "受注" }]}>
  <PageHeader title="受注" description="取引先からの発注です。新しい順に並びます。" />

  <FilterBar selects={[{ name: "status", label: "ステータス", value: status ?? "", allLabel: "すべて", options: statusOptions }]} />

  <DataTable caption="受注の一覧" columns={["注文番号", "取引先", "発注日", "ステータス", "お支払い", "合計"]} rowCount={items.length} emptyTitle="該当する受注はありません" emptyDescription="取引先が発注すると、ここに並びます。">
    {
      items.map((order) => (
        <Table.Row>
          <Table.Cell class="whitespace-nowrap tabular-nums">
            <RowLink href={`/orders/${order.id}`}>{order.orderNumber}</RowLink>
          </Table.Cell>
          <Table.Cell>
            {order.organizationName}
            <span class="text-muted-foreground tabular-nums">（{order.orgCode}）</span>
          </Table.Cell>
          <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{formatDate(order.placedAt)}</Table.Cell>
          <Table.Cell>
            <StatusBadge domain="order" value={order.status} />
          </Table.Cell>
          <Table.Cell>
            <StatusBadge domain="payment" value={order.paymentStatus} />
          </Table.Cell>
          <Table.Cell class="whitespace-nowrap tabular-nums">{formatYen(order.total)}</Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>

  <Pagination page={page} perPage={perPage} total={total} params={params} />
</ConsoleLayout>
