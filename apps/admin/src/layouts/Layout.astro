---
// The admin shell. Navigation lives here only; a screen carries the contents of its <main>.
//
// Not shadcn-svelte's Sidebar: it is a provider tree, so using it in Astro would put whole pages
// inside an island and drag server-resolved values into the client payload — the wrong side of
// the D-021 boundary. Static markup is enough for a nav.
import "../styles/admin.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
// Kept as one expression: mixing text and an expression inside <title> makes Prettier hoist the
// text out of the element.
const pageTitle = `${title}｜管理画面`;
const path = Astro.url.pathname;

const nav = [
  { href: "/", label: "ダッシュボード" },
  { href: "/applications", label: "新規取引申請" },
  { href: "/organizations", label: "取引先" },
  { href: "/orders", label: "受注" },
  { href: "/inquiries", label: "お問い合わせ" },
  { href: "/audit-logs", label: "操作履歴" },
];

const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <body class="flex min-h-dvh flex-col bg-background text-foreground">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground">本文へ移動</a>

    <header class="border-b border-border">
      <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center gap-x-8 gap-y-3 px-5 py-3 sm:px-8">
        <a href="/" class="text-sm font-semibold">ペット漢方 卸売 管理</a>

        <nav aria-label="管理メニュー">
          <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined} class="inline-block py-1 text-muted-foreground hover:text-foreground aria-[current=page]:font-medium aria-[current=page]:text-foreground">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>
  </body>
</html>
