---
// The document shell. Navigation and the console chrome live in ConsoleLayout.astro; this file
// is what a screen rendered outside the console (404, 500) still gets.
import "../styles/admin.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
// Kept as one expression: mixing text and an expression inside <title> makes Prettier hoist the
// text out of the element.
const pageTitle = `${title}｜管理画面`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex, nofollow" />

    {/* Inter ships no kana or kanji, so the Japanese face is a separate download. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <slot />
  </body>
</html>
