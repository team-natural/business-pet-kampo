# Copy to .dev.vars (gitignored) and fill in. Secrets only — non-secret values live in
# wrangler.jsonc's vars (DEV-10 §1-3, DEV-08 §8).
#
# In production these are set with `wrangler secret put <KEY>`, never in wrangler.jsonc.
#
# There is no Access bypass variable here on purpose: the local pseudo identity comes from
# wrangler.jsonc's access.dev block, which a deployed Worker never receives (D-029).

# Resend (DEV-10 §3). Used from S4 onward for application review notifications.
RESEND_API_KEY=re_xxxxxxxxxx
