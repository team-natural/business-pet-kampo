{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A custom entrypoint rather than the adapter's, because this Worker also needs `scheduled` for
  // the retention batch. src/worker.ts delegates `fetch` straight to @astrojs/cloudflare/handler
  // (OPS-02 §4-3; the adapter's `workerEntryPoint` option was removed in v13).
  "main": "./src/worker.ts",
  "name": "business-pet-kampo-admin",

  // 03:00 JST = 18:00 UTC the previous day. Deliberately outside Japanese business hours: the
  // batch deletes rows, and doing that while an operator is mid-screen is how a list refreshes
  // into a 404 (OPS-02 §4-3).
  "triggers": {
    "crons": ["0 18 * * *"],
  },
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },

  // Local-only pseudo identity, read by wrangler dev and the Cloudflare Vite plugin. Delete the
  // `identity` key to reproduce an unauthenticated request; delete the block and the Worker has
  // no Access context at all. It has no effect on a deployed Worker (D-029).
  "access": {
    "dev": {
      "aud": "business-pet-kampo-admin-dev",
      "identity": { "email": "dev-admin@example.test" },
    },
  },

  // vars is non-inheritable, so it's repeated in each env block below.
  // The CF_ACCESS_* pair is only used by the JWT fallback, which is the path that runs in
  // production: a Worker serving static assets sits behind an internal router that does not pass
  // ctx.access through (D-029). Both must be set in every deployed environment.
  "vars": {
    "APP_ENV": "development",
    "APP_NAME": "ペット漢方 卸売",
    "APP_URL": "http://localhost:5173",
    "CF_ACCESS_TEAM_DOMAIN": "replace-with-team.cloudflareaccess.com",
    "CF_ACCESS_AUD": "replace-with-access-aud-tag",
    // Used from S4 onward (application review notifications). APP_URL points at the public site
    // because that is where the links in those mails land, not at this subdomain.
    "MAIL_FROM_ADDRESS": "noreply@replace-with-domain.example",
    "MAIL_FROM_NAME": "ペット漢方 卸売",
    "MAIL_ADMIN_ALERTS": "ops@replace-with-domain.example",
  },

  // Shared with apps/public: create once, then copy the ids into both. They must match —
  // database_id also keys the shared local sqlite file. No KV and no R2 here: lockout counters
  // belong to apps/public (D-022) and file uploads do not exist (D-020).
  // migrations_dir is non-inheritable, like vars above.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-db-name",
      "database_id": "replace-with-database-id",
      "migrations_dir": "../../packages/schema/migrations",
    },
  ],

  "env": {
    "staging": {
      "vars": {
        "APP_ENV": "staging",
        "APP_NAME": "ペット漢方 卸売",
        "APP_URL": "https://staging.replace-with-domain.example",
        "CF_ACCESS_TEAM_DOMAIN": "replace-with-team.cloudflareaccess.com",
        "CF_ACCESS_AUD": "replace-with-access-aud-tag-staging",
        "MAIL_FROM_ADDRESS": "noreply@replace-with-domain.example",
        "MAIL_FROM_NAME": "ペット漢方 卸売",
        "MAIL_ADMIN_ALERTS": "ops@replace-with-domain.example",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "replace-with-db-name-staging",
          "database_id": "replace-with-database-id-staging",
          "migrations_dir": "../../packages/schema/migrations",
        },
      ],
    },
    "production": {
      "vars": {
        "APP_ENV": "production",
        "APP_NAME": "ペット漢方 卸売",
        "APP_URL": "https://replace-with-domain.example",
        "CF_ACCESS_TEAM_DOMAIN": "replace-with-team.cloudflareaccess.com",
        "CF_ACCESS_AUD": "replace-with-access-aud-tag-production",
        "MAIL_FROM_ADDRESS": "noreply@replace-with-domain.example",
        "MAIL_FROM_NAME": "ペット漢方 卸売",
        "MAIL_ADMIN_ALERTS": "ops@replace-with-domain.example",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "replace-with-db-name-production",
          "database_id": "replace-with-database-id-production",
          "migrations_dir": "../../packages/schema/migrations",
        },
      ],
    },
  },
}
