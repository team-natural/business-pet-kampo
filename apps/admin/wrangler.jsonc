{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "business-pet-kampo-admin",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },

  // vars is non-inheritable, so it's repeated in each env block below.
  // DEV_ADMIN_EMAIL stands in for Access, which neither local dev nor Playwright can pass. It is
  // absent from the staging/production blocks, and APP_ENV=production makes it inert even if
  // someone sets it there (D-022, pinned by tests/unit/access.test.ts).
  "vars": {
    "APP_ENV": "development",
    "ACCESS_TEAM_DOMAIN": "replace-with-team.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-access-aud-tag",
    "DEV_ADMIN_EMAIL": "dev-admin@example.test",
  },

  // Shared with apps/public: create once, then copy the ids into both. They must match —
  // database_id also keys the shared local sqlite file. No KV and no R2 here: lockout counters
  // belong to apps/public (D-022) and file uploads do not exist (D-020).
  // migrations_dir is non-inheritable, like vars above.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-db-name",
      "database_id": "replace-with-database-id",
      "migrations_dir": "../../packages/schema/migrations",
    },
  ],

  "env": {
    "staging": {
      "vars": {
        "APP_ENV": "staging",
        "ACCESS_TEAM_DOMAIN": "replace-with-team.cloudflareaccess.com",
        "ACCESS_AUD": "replace-with-access-aud-tag-staging",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "replace-with-db-name-staging",
          "database_id": "replace-with-database-id-staging",
          "migrations_dir": "../../packages/schema/migrations",
        },
      ],
    },
    "production": {
      "vars": {
        "APP_ENV": "production",
        "ACCESS_TEAM_DOMAIN": "replace-with-team.cloudflareaccess.com",
        "ACCESS_AUD": "replace-with-access-aud-tag-production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "replace-with-db-name-production",
          "database_id": "replace-with-database-id-production",
          "migrations_dir": "../../packages/schema/migrations",
        },
      ],
    },
  },
}
